generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PeriodeHoraire {
  SCOLAIRE
  VACANCES
}

model user {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime

  mot_de_passe  String?
  pronoms       String?
  role          Role      @default(USER)

  // Liaison Admin → Piscine (NULL si role=USER)
  piscineId     Int?
  piscine       Piscine?  @relation("AdminPiscine", fields: [piscineId], references: [id])

  sessions      session[]
  accounts      account[]
  favoris       Favori[]
  avis          Avis[]
}

model session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Piscine {
  id                  Int      @id @default(autoincrement())
  nom                 String
  adresse             String
  arrondissement      Int
  latitude            Float?
  longitude           Float?
  description         String?
  telephone           String?
  email               String?
  site_web            String?

  acces_pmr           Boolean  @default(false)
  queer_friendly      Boolean  @default(false)
  accepte_passe_paris Boolean  @default(true)
  is_open             Boolean  @default(true)
  espace_solarium     Boolean  @default(false)

  activites           String[]
  images_galerie      String[]

  prix_entree_normal     Float?
  prix_entree_reduit     Float?
  prix_carnet_normal     Float?
  prix_carnet_reduit     Float?
  prix_abonnement_normal Float?
  prix_abonnement_reduit Float?
  prix_brevet_natation   Float?

  seche_cheveux            Boolean @default(false)
  distributeur_equipements Boolean @default(false)
  casiers                  Boolean @default(false)
  vestiaires_mixtes        Boolean @default(false)
  cabines_individuelles    Boolean @default(false)
  douches_individuelles    Boolean @default(false)
  douches_collectives      Boolean @default(false)
  cabine_pmr               Boolean @default(false)
  distributeur_boisson     Boolean @default(false)

  last_updated_at     DateTime @updatedAt
  created_at          DateTime @default(now())

  admin               user[]   @relation("AdminPiscine")
  bassins             Bassin[]
  horaires_reguliers  HoraireRegulier[]
  horaires_exceptions HoraireException[]
  favoris             Favori[]
  avis                Avis[]
}

model Bassin {
  id             Int     @id @default(autoincrement())
  nom            String?
  longueur       Float?
  largeur        Float?
  profondeur_min Float?
  profondeur_max Float?
  nb_couloirs    Int?
  piscineId      Int

  piscine        Piscine @relation(fields: [piscineId], references: [id])
}

model HoraireRegulier {
  id              Int            @id @default(autoincrement())
  periode         PeriodeHoraire
  jour            String
  heure_ouverture String
  heure_fermeture String
  ferme           Boolean        @default(false)
  piscineId       Int

  piscine         Piscine        @relation(fields: [piscineId], references: [id])
}

model HoraireException {
  id              Int      @id @default(autoincrement())
  date_debut      DateTime
  date_fin        DateTime
  heure_ouverture String?
  heure_fermeture String?
  ferme           Boolean  @default(false)
  motif           String?
  piscineId       Int

  piscine         Piscine  @relation(fields: [piscineId], references: [id])
}

model Favori {
  id         String   @id @default(cuid())
  userId     String
  piscineId  Int
  created_at DateTime @default(now())

  user       user     @relation(fields: [userId], references: [id])
  piscine    Piscine  @relation(fields: [piscineId], references: [id])

  @@unique([userId, piscineId])
}

model Avis {
  id                        String   @id @default(cuid())
  note_accessibilite        Int?
  commentaire_accessibilite String?
  note_accueil              Int?
  commentaire_accueil       String?
  note_bassin               Int?
  commentaire_bassin        String?
  note_vestiaires           Int?
  commentaire_vestiaires    String?
  created_at                DateTime @default(now())
  userId                    String
  piscineId                 Int

  user                      user     @relation(fields: [userId], references: [id])
  piscine                   Piscine  @relation(fields: [piscineId], references: [id])

  @@unique([userId, piscineId])
}